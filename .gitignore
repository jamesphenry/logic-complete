# ==========================================
# Build Artifacts & Output Directories
# ==========================================
build/
bin/
obj/

# Executables (Root and Build levels)
*.exe
*.out
*.app
*.elf
*.o
*.a
*.so
*.dylib

# Dependency tracking files generated by gcc (-MMD -MP)
*.d

# ==========================================
# Test Framework & Execution Artifacts
# ==========================================
# Exclude test binaries generated during 'make test'
test_runner
*.test

# Coverage & Profiling (gcov, gprof)
*.gcda
*.gcno
*.gcov
gmon.out

# ==========================================
# Editor & IDE Directories
# ==========================================
# VS Code
.vscode/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json

# CLion / JetBrains
.idea/
cmake-build-*/

# Vim / Emacs temporary files
*~
*.swp
*.swo
.\#*

# Mac / Linux System Files
.DS_Store
.directory

# ==========================================
# Temporary Debug Logs & Dump Files
# ==========================================
*.log
*.tmp
memory_dump.bin

# ==========================================
# unimportant files that dont need tracking
# ==========================================
notes.md 
vgcore.*
