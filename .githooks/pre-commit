#!/bin/sh

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

echo "Running Logic Complete tests..."
echo

make test

if [ "$?" -ne 0 ]; then
    echo
    echo "❌ Tests failed. Commit aborted."
    exit 1
fi

echo
echo "Updating README..."

python3 scripts/update_readme.py

if [ "$?" -ne 0 ]; then
    echo
    echo "❌ Could not update README. Commit aborted."
    exit 1
fi

git add README.md

echo
echo "✅ Tests passed and README updated."
